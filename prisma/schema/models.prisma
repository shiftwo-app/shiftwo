// shiftwo のモデル定義（Postgres と SQLite / D1 で共通）。
// generator と datasource は DB ごとに scripts/prisma-schemas.ts が付けて
// prisma/generated-schema/<provider>/schema.prisma を作る。ここには書かない。
// 両方の DB で使える書き方だけにすること（配列型 String[] / Json[] や、@db.* の型指定は使えない）

model Staff {
  id              String    @id @default(uuid())
  name            String
  preferredRoles  Role[]    @relation("StaffPreferredRoles")
  // TimeRange（start, end）の配列。SQLite（D1）には配列型がないので、Json の中に配列で持つ。
  // @default("[]") は付けない（SQLite では Prisma が既定値を空文字列で出力してしまう）。作る側で [] を渡す
  unavailableTimes Json
  shifts          Shift[]
}

model Role {
  id              String    @id @default(uuid())
  name            String
  color           String
  requiredStaffCount Int
  preferredBy     Staff[]   @relation("StaffPreferredRoles")
  shifts          Shift[]
}

model Event {
  id    String @id @default(uuid())
  name  String
  rooms Room[]
}

model Room {
  id        String @id @default(uuid())
  name      String
  // TimeRange（start, end）の配列（unavailableTimes と同じ理由で Json）
  timeTable Json
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id])
}

model Shift {
  id              String    @id @default(uuid())
  staff           Staff     @relation(fields: [staffId], references: [id])
  staffId         String
  role            Role      @relation(fields: [roleId], references: [id])
  roleId          String
  timeRange       Json // TimeRange (start, end)
  isPreferredRole Boolean
  status          ShiftStatus @default(draft)
}

enum ShiftStatus {
  draft
  confirmed
}

model ShiftSetting {
  id              String    @id @default(uuid())
  timeUnitMinutes Int
}

// ---- ログイン（Better Auth）----
// npx auth generate --adapter prisma で作った定義をそのまま使う。Better Auth を上げたら作り直して見比べる。
// テーブル名は Better Auth の既定（user・session・account・verification）

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  // はじめての設定（/welcome）を済ませた日時。Better Auth の additionalFields（auth.server.ts）と合わせる
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
