// shiftwo のモデル定義（Postgres と SQLite / D1 で共通）。
// generator と datasource は DB ごとに scripts/prisma-schemas.ts が付けて
// prisma/generated-schema/<provider>/schema.prisma を作る。ここには書かない。
// 両方の DB で使える書き方だけにすること（配列型 String[] / Json[] や、@db.* の型指定は使えない）

model Staff {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  preferredRoles  Role[]    @relation("StaffPreferredRoles")
  // TimeRange（start, end）の配列。SQLite（D1）には配列型がないので、Json の中に配列で持つ。
  // @default("[]") は付けない（SQLite では Prisma が既定値を空文字列で出力してしまう）。作る側で [] を渡す
  unavailableTimes Json
  shifts          Shift[]

  @@index([organizationId])
}

// 役割。日常シフトの役割はテナントごと（eventId なし）、イベントの役割はイベントごと（eventId あり）で、分けて持つ
model Role {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  color           String
  requiredStaffCount Int
  preferredBy     Staff[]   @relation("StaffPreferredRoles")
  shifts          Shift[]

  @@index([organizationId])
  @@index([tenantId, eventId])
}

// イベント（単発運用）。テナントの下に置く。URL は /o/<団体>/t/<テナント>/e/<slug>
model Event {
  id              String @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  // 時間粒度の上書き（null ならテナントの値を使う）
  timeUnitMinutes Int?
  rooms           Room[]
  roles           Role[]
  shifts          Shift[]
  members         EventMember[]

  @@unique([tenantId, slug])
  @@index([organizationId])
}

model Room {
  id        String @id @default(uuid())
  name      String
  // TimeRange（start, end）の配列（unavailableTimes と同じ理由で Json）
  timeTable Json
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// シフト。必ずテナントに属し、イベントに紐づかない（eventId なし）ものは日常シフト
model Shift {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 団体を消したときに一緒に消えるよう Cascade（スタッフ・役割を消すと、そのシフトも消える）
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId         String
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId          String
  timeRange       Json // TimeRange (start, end)
  isPreferredRole Boolean
  status          ShiftStatus @default(draft)

  @@index([organizationId, status])
  @@index([tenantId, eventId, status])
}

enum ShiftStatus {
  draft
  confirmed
}

// テナント（店舗にあたる単位）。URL は /o/<団体>/t/<slug>。団体を作ると 1 つ作られる
model Tenant {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  // 時間粒度（分）。イベントで上書きできる
  timeUnitMinutes Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          Event[]
  roles           Role[]
  shifts          Shift[]
  members         TenantMember[]

  @@unique([organizationId, slug])
}

// テナントでの役割（店長など）。団体の役割より強いときだけ効く（強い方が勝つ）
model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([tenantId, memberId])
  @@index([memberId])
}

// イベントでの役割。団体・テナントの役割より強いときだけ効く（強い方が勝つ）
model EventMember {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([eventId, memberId])
  @@index([memberId])
}

// ---- 団体（複数の団体が同じインスタンスを使う）----

// 団体。URL は /o/<slug>
model Organization {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      Member[]
  invites      Invite[]
  staffs       Staff[]
  roles        Role[]
  tenants      Tenant[]
  events       Event[]
  shifts       Shift[]
}

enum MemberRole {
  owner
  leader
  staff
  guest
}

// 団体への所属。表示名は団体ごとに決められる
model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  displayName    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenantRoles    TenantMember[]
  eventRoles     EventMember[]

  @@unique([organizationId, userId])
  @@index([userId])
}

// 招待コード。団体に参加するときに入力する
model Invite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @unique
  // 参加したときの役割（owner にはできない）
  role           MemberRole
  // 使える回数（null なら制限なし）と、使った回数
  maxUses        Int?
  uses           Int          @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ---- ログイン（Better Auth）----
// npx auth generate --adapter prisma で作った定義をそのまま使う。Better Auth を上げたら作り直して見比べる。
// テーブル名は Better Auth の既定（user・session・account・verification）

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  // はじめての設定（/welcome）を済ませた日時。Better Auth の additionalFields（auth.server.ts）と合わせる
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invites       Invite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
