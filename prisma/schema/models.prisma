// shiftwo のモデル定義（Postgres と SQLite / D1 で共通）。
// generator と datasource は DB ごとに scripts/prisma-schemas.ts が付けて
// prisma/generated-schema/<provider>/schema.prisma を作る。ここには書かない。
// 両方の DB で使える書き方だけにすること（配列型 String[] / Json[] や、@db.* の型指定は使えない）。
// ただし Better Auth が文字列の配列で持つ項目は StringList と書く（DB ごとの型は scripts/prisma-schemas.ts が決める）

model Staff {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  // 紐づく団体のメンバー（アカウント）。任意で、1 人のメンバーに紐づくスタッフは 1 人まで。アイコンなどに使う
  memberId        String?   @unique
  member          Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // 希望する持ち場（relation の名前は、中間テーブルの名前を変えないよう StaffPreferredRoles のまま）
  preferredPositions Position[] @relation("StaffPreferredRoles")
  // TimeRange（start, end）の配列。SQLite（D1）には配列型がないので、Json の中に配列で持つ。
  // @default("[]") は付けない（SQLite では Prisma が既定値を空文字列で出力してしまう）。作る側で [] を渡す
  unavailableTimes Json
  shifts          Shift[]
  // スタッフが出した希望（団体全体と、テナント・イベントごとの上書き）
  preferences     StaffPreference[]

  @@index([organizationId])
}

// 持ち場（受付・レジなど）。日常シフトの持ち場はテナントごと（eventId なし）、イベントの持ち場はイベントごと（eventId あり）で、分けて持つ。
// 権限の「ロール」とは別のもの。DB のテーブル名は以前の名前（Role）のまま
model Position {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  color           String
  requiredStaffCount Int
  // 休憩の持ち場か（レポートで、このシフトを休憩として数える。充足率には入れない）
  isBreak         Boolean   @default(false)
  preferredBy     Staff[]   @relation("StaffPreferredRoles")
  shifts          Shift[]
  // この持ち場を希望に入れている希望（テナント・イベントごとの希望だけが持ち場を持つ）
  preferences     StaffPreference[] @relation("StaffPreferencePositions")

  @@index([organizationId])
  @@index([tenantId, eventId])
  @@map("Role")
}

// イベント（単発運用）。テナントの下に置く。URL は /o/<団体>/t/<テナント>/e/<slug>
model Event {
  id              String @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  // 時間粒度の上書き（null ならテナントの値を使う）
  timeUnitMinutes Int?
  // 持ち場を使うかの上書き（null ならテナントの設定のまま）
  positionsEnabled Boolean?
  // 開催期間（任意）。決めておくと、希望の休憩が期間の外にあるとき断る
  startsAt        DateTime?
  endsAt          DateTime?
  // このイベントの希望の締切（null なら締切なし）。過ぎると本人は変えられない（シフトを編集できる人は変えられる）
  preferenceDeadline DateTime?
  preferences     StaffPreference[]
  rooms           Room[]
  positions       Position[]
  shifts          Shift[]
  members         EventMember[]

  @@unique([tenantId, slug])
  @@index([organizationId])
}

model Room {
  id        String @id @default(uuid())
  name      String
  // TimeRange（start, end）の配列（unavailableTimes と同じ理由で Json）
  timeTable Json
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// シフト。必ずテナントに属し、イベントに紐づかない（eventId なし）ものは日常シフト
model Shift {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 団体を消したときに一緒に消えるよう Cascade（スタッフ・役割を消すと、そのシフトも消える）
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId         String
  // 持ち場。持ち場を使わない単位（positionsEnabled がオフ）では null
  position        Position? @relation(fields: [positionId], references: [id], onDelete: Cascade)
  // DB の列名は以前の名前（roleId）のまま
  positionId      String?   @map("roleId")
  timeRange       Json // TimeRange (start, end)
  // 希望どおりの持ち場か（DB の列名は以前の名前のまま）
  isPreferredPosition Boolean @map("isPreferredRole")
  status          ShiftStatus @default(draft)
  // 変えるたびに 1 増える。保存のときに、読んだときの値と同じかを確かめる（同時に直したときの上書きを防ぐ）
  version         Int       @default(1)

  @@index([organizationId, status])
  @@index([tenantId, eventId, status])
}

enum ShiftStatus {
  draft
  confirmed
}

// テナント（店舗にあたる単位）。URL は /o/<団体>/t/<slug>。団体を作ると 1 つ作られる
model Tenant {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  // 時間粒度（分）。イベントで上書きできる
  timeUnitMinutes Int
  // 持ち場を使うか（null なら団体の設定のまま）。イベントで上書きできる
  positionsEnabled Boolean?
  // レポートで、シフトとシフトのあいだの空きを休憩とみなす長さ（分）
  breakGapMinutes Int        @default(15)
  // このテナントの希望の締切（null なら締切なし）
  preferenceDeadline DateTime?
  preferences     StaffPreference[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          Event[]
  positions       Position[]
  shifts          Shift[]
  members         TenantMember[]

  @@unique([organizationId, slug])
}

// テナントで割り当てたロール（店長など）。そのテナントと下のイベントで、シフトに関わる権限を上乗せする
model TenantMember {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      OrgRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, memberId, roleId])
  @@index([memberId])
}

// イベントで割り当てたロール。そのイベントで、シフトに関わる権限を上乗せする
model EventMember {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      OrgRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, memberId, roleId])
  @@index([memberId])
}

// ---- 団体（複数の団体が同じインスタンスを使う）----

// 団体。URL は /o/<slug>
model Organization {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  // 参加の条件にする Discord サーバー（null なら条件なし）。名前とアイコンは設定したときの表示用
  discordGuildId   String?
  discordGuildName String?
  discordGuildIcon String?
  // 持ち場を使うか（団体の基本。テナント・イベントで上書きできる）。オフなら、シフトは人と時間だけで組む
  positionsEnabled Boolean    @default(true)
  // 団体全体の希望の締切（null なら締切なし）
  preferenceDeadline DateTime?
  preferences  StaffPreference[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      Member[]
  roles        OrgRole[]
  invites      Invite[]
  staffs       Staff[]
  positions    Position[]
  tenants      Tenant[]
  events       Event[]
  shifts       Shift[]
}

// 権限のロール（Discord のロールのようなもの）。ロールごとに権限の項目を持ち、1 人が複数のロールを持てる（権限は足し合わせ）。
// シフトの持ち場（Position）とは別のもの
model OrgRole {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String
  // 権限の項目（文字列の配列。src/lib/org/permissions.ts の PERMISSIONS）
  permissions    Json
  // 並び順（小さいほど上）
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        MemberRoleAssignment[]
  tenantMembers  TenantMember[]
  eventMembers   EventMember[]
  invites        Invite[]

  @@index([organizationId])
}

// メンバーが団体で持つロール
model MemberRoleAssignment {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      OrgRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([memberId, roleId])
  @@index([roleId])
}

// 団体への所属。表示名は団体ごとに決められる
model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // オーナーは常に全権限を持ち、外せない
  isOwner        Boolean      @default(false)
  displayName    String
  // 団体の Discord サーバーを抜けて、見られなくなった日時（メンバー情報は残し、戻れば null に戻す）
  guildSuspendedAt DateTime?
  // 表示に使うアイコン（団体が Discord サーバーを指定していればそのサーバーでのアイコン、なければ Discord のアイコン）
  avatarUrl      String?
  // この団体でだけ使う、本人がアップロードしたアイコン（保存先のキー）。あれば何よりも優先する
  uploadedAvatarKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  roles          MemberRoleAssignment[]
  staff          Staff?
  tenantRoles    TenantMember[]
  eventRoles     EventMember[]

  @@unique([organizationId, userId])
  @@index([userId])
}

// 招待コード。団体に参加するときに入力する
model Invite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @unique
  // 参加したときに付けるロール
  roleId         String
  role           OrgRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // 使える回数（null なら制限なし）と、使った回数
  maxUses        Int?
  uses           Int          @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ---- ログイン（Better Auth）----
// npx auth generate --adapter prisma で作った定義をそのまま使う。Better Auth を上げたら作り直して見比べる。
// テーブル名は Better Auth の既定（user・session・account・verification）

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  // 本人がアップロードしたアイコン（保存先のキー）。image は本人が好きな URL に書き換えられるので、アップロードはこちらに持つ
  uploadedAvatarKey String?
  // はじめての設定（/welcome）を済ませた日時。Better Auth の additionalFields（auth.server.ts）と合わせる
  onboardedAt   DateTime?
  // 本人が選んだ画面とメールの言語（ja・en・zh-Hans・zh-Hant・ko）。null ならブラウザの言語に合わせる。
  // Better Auth の additionalFields（auth.server.ts）と合わせる
  locale        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invites       Invite[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  passkeys           Passkey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// スタッフの希望（FR-5）。団体全体の希望を基本にして、テナント・イベントごとに上書きできる。
// あるイベントのシフトでは、イベントの希望 → テナントの希望 → 団体の希望 の順に、あるものを使う
// （持ち場はテナント・イベントごとのものなので、持ち場の希望はその単位の希望にしかない）
model StaffPreference {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 両方 null なら団体全体、tenantId だけならテナント、両方あればイベントの希望
  tenantId        String?
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 単位の名前（org・t:<テナントの ID>・e:<イベントの ID>）。null を含む一意の制約は DB で扱いが違うので、これで一意にする
  scopeKey        String
  staffId         String
  staff           Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // 希望する休憩・参加できない時間。TimeRange（start, end）の配列（unavailableTimes と同じ理由で Json）
  breaks          Json
  // 希望する持ち場（優先順位なし）
  positions       Position[]   @relation("StaffPreferencePositions")
  // メモ（200 文字まで）
  memo            String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([staffId, scopeKey])
  @@index([organizationId])
  @@index([tenantId])
  @@index([eventId])
}

// パスキー（Better Auth の passkey プラグイン）。メール・Discord に加えて、指紋や顔などでログインできる
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ---- MCP（AI のアシスタントからシフトヲを使う）のための OAuth の認可サーバー（Better Auth の jwt / mcp プラグイン）----
// 項目は Better Auth が決めたもの。json の項目は Better Auth が JSON の文字列にして書くので String で持つ

// アクセストークン（JWT）に署名する鍵
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// つないだ MCP のクライアント（AI のアシスタントのアプリ）
model OauthClient {
  id                               String     @id
  clientId                         String     @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?   @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           StringList?
  clientCredentialsScopes          StringList?
  userId                           String?
  user                             User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         StringList?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     StringList
  postLogoutRedirectUris           StringList?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       StringList?
  responseTypes                    StringList?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?   @default(false)
  referenceId                      String?
  metadata                         String?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

// トークンの宛先（シフトヲでは /api/mcp だけ）
model OauthResource {
  id                            String     @id
  identifier                    String     @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 StringList?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?   @default(false)
  disabled                      Boolean?   @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?       @default(1)
  metadata                      String?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   String?
  createdAt  DateTime?

  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String     @id
  token                   String     @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               StringList?
  requestedUserInfoClaims StringList?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  StringList
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String     @id
  token                   String?    @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               StringList?
  requestedUserInfoClaims StringList?
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            String?
  scopes                  StringList

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

// 本人が、どのクライアントに何を許したか
model OauthConsent {
  id                      String     @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               StringList?
  requestedUserInfoClaims StringList?
  scopes                  StringList
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}
