{
	"name": "shiftwo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#platform": "./src/platform/node.server.ts",
		"#cloudflare-database": "./src/platform/cloudflare-d1.server.ts",
		"#worker-exports": "./src/platform/worker-exports.node.ts"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"start": "srvx --prod -s ../client dist/server/server.js",
		"dev:cloudflare": "CLOUDFLARE=1 vp dev",
		"build:cloudflare": "CLOUDFLARE=1 vp build",
		"preview:cloudflare": "CLOUDFLARE=1 vp preview",
		"deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
		"d1:migrate:local": "wrangler d1 migrations apply DB --local",
		"d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"test": "vp test",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"prisma:seed": "prisma db seed",
		"postinstall": "pnpm prisma:generate",
		"prisma:generate": "node scripts/prisma-schemas.ts && DATABASE_PROVIDER=postgresql prisma generate && DATABASE_PROVIDER=sqlite prisma generate && prisma generate --schema prisma/generated-schema/postgresql-workerd/schema.prisma && prisma generate --schema prisma/generated-schema/sqlite-workerd/schema.prisma",
		"prisma:migrate": "node scripts/prisma-migrate.ts"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.18",
		"@better-auth/mcp": "1.7.18",
		"@better-auth/oauth-provider": "1.7.18",
		"@modelcontextprotocol/server": "2.4.0",
		"@prisma/adapter-d1": "^7.10.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@prisma/client-runtime-utils": "7.10.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"better-auth": "^1.7.18",
		"date-fns": "^4.1.0",
		"jose": "6.2.15",
		"nodemailer": "^10.3.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"srvx": "^1.0.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@vitejs/plugin-react": "^6.2.1",
		"prisma": "^7.10.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^5",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "^4.158.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.15.0"
}
