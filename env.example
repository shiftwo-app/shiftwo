# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://admin:shiftwo2025@db:5432/shiftwo?schema=public"
# どの DB を使うか（postgresql または sqlite）。未設定なら postgresql。
# sqlite は Cloudflare D1 用（Node では使えない）
# DATABASE_PROVIDER="postgresql"

# pnpm prisma:migrate check で、Postgres のマイグレーションとスキーマを比べるときに使う、捨ててよい DB
# SHADOW_DATABASE_URL="postgresql://admin:shiftwo2025@db:5432/shiftwo_shadow?schema=public"

# ---- ログイン（Better Auth）----
# Cookie やトークンの署名に使う秘密の値。本番では必ず設定する（openssl rand -base64 32 などで作る）
BETTER_AUTH_SECRET=""
# このアプリの URL（メールのリンクや Discord のコールバックに使う）
BETTER_AUTH_URL="http://localhost:3000"

# Discord ログイン（任意）。https://discord.com/developers/applications でアプリを作り、
# OAuth2 の Redirects に <BETTER_AUTH_URL>/api/auth/callback/discord を登録する。
# 両方を設定したときだけ、ログイン画面に「Discord でログイン」が出る
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""

# メールの送り方。未設定なら、開発中は console（送らずにターミナルへ出す）。本番では必須。
# smtp（SMTP_URL）か cloudflare（Cloudflare Email Service）。送り主は MAIL_FROM（と MAIL_FROM_NAME）。
# cloudflare は、Workers では binding（wrangler.jsonc）、Node では REST API（CLOUDFLARE_ACCOUNT_ID・CLOUDFLARE_EMAIL_API_TOKEN）で送る
# MAIL_TRANSPORT="console"

# アップロードしたファイル（アイコン）の保存先。Node では local（ディスク）。Cloudflare では r2（wrangler.jsonc で設定する）
# STORAGE_DRIVER="local"
# local のときの置き場所（既定は data/uploads）。Docker では volume にする
# STORAGE_DIR="data/uploads"
