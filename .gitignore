# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/.output/
/dist/
/.tanstack/
/.nitro/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# pnpm
.pnpm-store/
# prisma client とスキーマ（pnpm prisma:generate で作る）
/src/generated/
/prisma/generated-schema/
# SQLite のマイグレーションを作るときのローカル DB
/prisma/*.db
/prisma/*.db-journal

# アップロードしたファイル（STORAGE_DRIVER=local の既定の置き場所）
/data/

# Cloudflare（wrangler のローカルの状態と、ローカルの秘密の値）
/.wrangler/
.dev.vars*
