# セルフホスト（deploy/docker/compose.yml）の設定。.env にコピーして書き換える。
# このファイルは app にもそのまま渡る（DATABASE_URL は compose.yml が POSTGRES_PASSWORD から作る）

# Postgres のパスワード（openssl rand -base64 24 などで作る）
POSTGRES_PASSWORD=""
# 公開するポート
PORT=3000

# ---- ログイン（Better Auth）----
# 秘密の値（openssl rand -base64 32 などで作る）
BETTER_AUTH_SECRET=""
# このアプリを開く URL（リバースプロキシの後ろなら、外から見た https の URL）
BETTER_AUTH_URL="http://localhost:3000"

# Discord ログイン（任意）。Redirects に <BETTER_AUTH_URL>/api/auth/callback/discord を登録する
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""

# ---- メール（ログインの確認コード）----
# smtp（ふつうのメールサーバー）か cloudflare（Cloudflare Email Service の REST API）
MAIL_TRANSPORT="smtp"
# 送り主（cloudflare のときは、Email Sending に登録したドメインのアドレス）
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME="shiftwo"

# smtp のとき：smtp://ユーザー:パスワード@ホスト:587（465 番なら smtps://）。記号は URL エンコードする
SMTP_URL=""

# cloudflare のとき：アカウント ID と、「Email Sending: Edit」の権限を持つ API トークン
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_EMAIL_API_TOKEN=""
